{
  "name": "birwal-react-comment-lib",
  "version": "1.0.0",
  "description": "High-performance, ultra-customizable nested threaded comments component library for React and Next.js built with MUI, React Hook Form, and Emoji Picker",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamsumitkumar64/birwal-react-comment-lib.git"
  },
  "bugs": {
    "url": "https://github.com/iamsumitkumar64/birwal-react-comment-lib/issues"
  },
  "homepage": "https://github.com/iamsumitkumar64/birwal-react-comment-lib#readme",
  "keywords": [
    "react",
    "react-comments",
    "nextjs",
    "mui",
    "material-ui",
    "comments",
    "nested-comments",
    "threaded-comments",
    "discussion",
    "forum",
    "emoji-picker",
    "react-hook-form",
    "typeorm",
    "prisma",
    "comment-tree"
  ],
  "author": "Sumit Kumar (Birwal)",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:lib": "tsup",
    "prepare": "npm run build:lib",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.0.0 || ^4.0.0 || ^5.0.0",
    "emoji-picker-react": "^4.19.1",
    "react-hook-form": "^7.50.0",
    "zod": "^3.23.0"
  },
  "peerDependencies": {
    "@emotion/react": "^11.0.0",
    "@emotion/styled": "^11.0.0",
    "@mui/icons-material": "^5.0.0 || ^6.0.0 || ^7.0.0 || ^9.0.0",
    "@mui/material": "^5.0.0 || ^6.0.0 || ^7.0.0 || ^9.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@emotion/react": {
      "optional": true
    },
    "@emotion/styled": {
      "optional": true
    }
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4",
    "tsup": "^8.5.1",
    "typescript": "^5"
  }
}
